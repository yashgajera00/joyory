# Joyory React + Vite Frontend - Environment Configuration

# Local Development (leave empty or set to /api so Vite proxy routes to Django):
# VITE_API_BASE_URL=/api

# Production Deployment on Vercel:
# Set this in your Vercel Project Settings > Environment Variables:
VITE_API_BASE_URL=https://joyory.pythonanywhere.com/api
