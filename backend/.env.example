# Joyory Django REST Framework Backend - Environment Configuration
# Copy this file to .env and adjust values for your environment.

# DEBUG Mode: True for local development, False for production (PythonAnywhere)
DEBUG=True

# Django Secret Key: Keep secret in production! Generate a secure key for PythonAnywhere.
SECRET_KEY=django-insecure-joyory-dev-secret-key-change-in-prod

# Allowed Hosts: Comma-separated list of hostnames
# Local development: localhost,127.0.0.1
# Production: joyory.pythonanywhere.com,localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1,joyory.pythonanywhere.com

# CORS Allowed Origins: Comma-separated list of frontend URLs allowed to make requests
# Include your Vercel frontend URL and local Vite server
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://joyory-shopping.vercel.app

# CSRF Trusted Origins: Comma-separated list of trusted origins for CSRF validation
# Must include scheme (https://). Include your Vercel URL and PythonAnywhere backend domain.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://joyory-shopping.vercel.app,https://joyory.pythonanywhere.com

# External Weather & Air Quality API (OpenWeatherMap or equivalent)
# If omitted or invalid, the climate engine seamlessly utilizes resilient fallback data
WEATHER_API_KEY=your_weather_api_key_here

# Gemini Vision API — NEVER expose this key in frontend code or Git
# Get your key from https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_NAME=gemini-3.6-flash
